PORT=5000
# Адрес фронтенда (CORS, ссылки в письмах, редиректы после OAuth)
CLIENT_URL=http://localhost:3000
# Публичный адрес этого бэкенда; redirect URI в Google Cloud Console:
# <SERVER_URL>/api/integrations/google/callback
SERVER_URL=http://localhost:5000

DB_NAME=your_db_name
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change_me

# Секреты JWT: у каждого должно быть своё длинное случайное значение, например
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_SECRET=change_me
REFRESH_SECRET=change_me
OAUTH_STATE_SECRET=change_me

GOOGLE_CLIENT_ID=change_me
GOOGLE_CLIENT_SECRET=change_me

# Почта для писем о сбросе пароля (для Gmail — пароль приложения, не основной пароль)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=change_me
SMTP_PASS=change_me
