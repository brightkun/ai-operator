PORT=5000
# Адрес фронтенда (CORS, ссылки в письмах, редиректы после OAuth)
CLIENT_URL=http://localhost:3000
# Публичный адрес этого бэкенда; redirect URI в Google Cloud Console:
# <SERVER_URL>/api/integrations/google/callback
SERVER_URL=http://localhost:5000

DB_NAME=your_db_name
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change_me

# Секреты JWT: у каждого должно быть своё длинное случайное значение, например
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_SECRET=change_me
REFRESH_SECRET=change_me
OAUTH_STATE_SECRET=change_me

GOOGLE_CLIENT_ID=change_me
GOOGLE_CLIENT_SECRET=change_me

# Почта для писем о сбросе пароля (для Gmail — пароль приложения, не основной пароль)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=change_me
SMTP_PASS=change_me

# Фоновая синхронизация Google (минуты, 0 — выключить). Первая через ~90 секунд после старта.
# SYNC_INTERVAL_MINUTES=30

# AI-ассистент: любой OpenAI-совместимый API. По умолчанию — Gemini (бесплатный тариф).
# Ключ: https://aistudio.google.com/apikey
# На бесплатном тарифе Google может использовать запросы (в т.ч. фрагменты писем) для улучшения своих моделей.
LLM_API_KEY=change_me
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-3.8-flash
# Запасные модели через запятую: подключаются при перегрузке (503) или исчерпанной квоте основной.
# По умолчанию для Gemini: gemini-3.5-flash,gemini-3.6-flash,gemini-3.1-flash-lite. Пусто — отключить.
# LLM_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.6-flash
# Локально через Ollama: LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=qwen2.5:7b  LLM_API_KEY=ollama
